# Codexrev — example environment configuration
# Copy to .env and fill in your values.

# ─── LLM Provider Selection ──────────────────────────────────────
# CODEXREV_PROVIDER can be: openai | anthropic | google | litellm | ollama | lmstudio
CODEXREV_PROVIDER=openai
CODEXREV_MODEL=gpt-4o

# ─── OpenAI ───────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Anthropic ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ─── Google Gemini ───────────────────────────────────────────────
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false

# ─── LiteLLM (OpenAI-compatible) ─────────────────────────────────
LITELLM_API_KEY=
LITELLM_BASE_URL=http://localhost:4000

# ─── Ollama (local OpenAI-compatible) ────────────────────────────
# Start the daemon with `ollama serve`, then `ollama pull <model>`.
OLLAMA_BASE_URL=http://localhost:11434/v1
# Ollama does not require an API key by default. Set OLLAMA_API_KEY
# only if you've enabled auth on your daemon.
OLLAMA_API_KEY=

# ─── LM Studio (local OpenAI-compatible) ─────────────────────────
# Open LM Studio's Developer tab and start the local server.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LM Studio does not require an API key by default. Set LMSTUDIO_API_KEY
# only if you've enabled one in the desktop app.
LMSTUDIO_API_KEY=

# ─── Codexrev runtime ────────────────────────────────────────────
CODEXREV_HOME=~/.codexrev
CODEXREV_LOG_LEVEL=info
CODEXREV_TELEMETRY=false
CODEXREV_SANDBOX=auto
CODEXREV_THEME=dark
CODEXREV_NO_UPDATE=0
