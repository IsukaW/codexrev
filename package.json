{
  "name": "codexrev",
  "version": "0.1.0",
  "description": "Codexrev — a multi-provider, agentic command-line AI assistant for code, research, and shell automation.",
  "type": "module",
  "main": "./dist/api.cjs",
  "module": "./dist/api.js",
  "exports": {
    ".": {
      "import": "./dist/api.js",
      "require": "./dist/api.cjs"
    },
    "./tools": {
      "import": "./dist/tools.js",
      "require": "./dist/tools.cjs"
    }
  },
  "bin": {
    "codexrev": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node scripts/start.js",
    "dev": "node scripts/start.js --dev",
    "clean": "node scripts/clean.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/postinstall.js",
    "prepare": "npm run build"
    ,"release": "npm publish --access public"
  },
  "keywords": [
    "codexrev",
    "ai",
    "cli",
    "agent",
    "llm",
    "openai",
    "anthropic",
    "gemini",
    "litellm",
    "mcp",
    "developer-tools"
  ],
  "author": "Codexrev Contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/codexrev/codexrev.git"
  },
  "bugs": {
    "url": "https://github.com/codexrev/codexrev/issues"
  },
  "homepage": "https://github.com/codexrev/codexrev#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@google/genai": "^0.7.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.54.0",
    "@opentelemetry/resources": "^1.27.0",
    "@opentelemetry/sdk-node": "^0.54.0",
    "@opentelemetry/sdk-trace-base": "^1.27.0",
    "@opentelemetry/semantic-conventions": "^1.27.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "diff": "^7.0.0",
    "dotenv": "^16.4.5",
    "glob": "^11.0.0",
    "html-to-text": "^9.0.5",
    "ink": "^6.0.0",
    "ink-big-text": "^2.0.0",
    "ink-gradient": "^3.0.0",
    "ink-select-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "keytar": "^7.9.0",
    "lowlight": "^3.3.0",
    "openai": "^4.73.0",
    "react": "^19.0.0",
    "shell-quote": "^1.8.1",
    "simple-git": "^3.27.0",
    "strip-json-comments": "^5.0.1",
    "undici": "^7.0.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/diff": "^6.0.0",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/shell-quote": "^1.7.5",
    "@types/yargs": "^17.0.33",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
